# Azure App Registration credentials
# Tạo app tại: https://portal.azure.com > Azure Active Directory > App registrations
AZURE_CLIENT_ID=your-application-client-id-here
AZURE_TENANT_ID=common

# AZURE_TENANT_ID options:
#   "common"        - Tài khoản Microsoft cá nhân VÀ tổ chức (khuyên dùng)
#   "organizations" - Chỉ tài khoản tổ chức (work/school)
#   "consumers"     - Chỉ tài khoản cá nhân (Outlook.com, Hotmail, Live)
#   "<tenant-id>"   - Tenant ID cụ thể của tổ chức bạn
